# Flask
SECRET_KEY=replace_with_a_long_random_secret
FLASK_DEBUG=0

# Supabase PostgreSQL: use the Connect dialog's shared Transaction pooler URL
# (port 6543) for Vercel. Percent-encode reserved characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Vercel sets this automatically. Leave unset for local SQLite development.
# AUTO_CREATE_SCHEMA=0

# Application
APP_TIMEZONE=Asia/Manila
SENSOR_OFFLINE_TIMEOUT_MINUTES=10
DEMO_MODE=0
COOKIE_SECURE=0

# Optional online AI for free-form chat. Monitoring summaries are sent to Groq.
# Keep the real API key in .env or your hosting provider's secret settings only.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20

# Optional local Ollama fallback (install Ollama and pull a model separately)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
